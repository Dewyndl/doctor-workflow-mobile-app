{
  "mcpServers": {
    "android-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "android-mcp-server"
      ],
      "env": {}
    },
    "maestro": {
      "type": "stdio",
      "command": "maestro",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  }
}